# ==========================
# Enable Rewrite Engine
# ==========================
RewriteEngine On

# ==========================
# Detect Local Environment
# ==========================
# Matches:
# - localhost
# - 127.0.0.1
# - Any LAN IP like 192.168.x.x
RewriteCond %{HTTP_HOST} ^localhost [NC,OR]
RewriteCond %{HTTP_HOST} ^127\.0\.0\.1 [NC,OR]
RewriteCond %{HTTP_HOST} ^192\.168\.[0-9]+\.[0-9]+ [NC]
RewriteRule ^ - [E=BASE:/source-code-erp/]

# ==========================
# Live Server (default)
# ==========================
RewriteCond %{ENV:BASE} =""
RewriteRule ^ - [E=BASE:/]

# ==========================
# Apply the RewriteBase
# ==========================
RewriteBase %{ENV:BASE}

# ==========================
# Example Rewrite Rules
# ==========================
# Send everything through index.php (except real files/folders)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
